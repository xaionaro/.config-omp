# Runtime state and generated artifacts (not configuration)
install-id
run/
logs/
cache/
natives/
*.db
*.db-shm
*.db-wal
agent/last-changelog-version
agent/cache/
agent/predict/
agent/sessions/
agent/terminal-sessions/
agent/custom-session-files/
agent/blobs/
# Built executables and their receipts in agent/eci/bin stay ignored. The negated
# entries are tracked codex-style on-demand wrappers or scripts, not prebuilt binaries.
agent/eci/bin/*
!agent/eci/bin/owned-command
!agent/eci/bin/status-report
!agent/eci/bin/eci-runtime-sync

# Secrets and credentials
auth*.json
agent/auth*.json
*.env
.env
.env.*
*.key
*.pem
*.token
*.secret
