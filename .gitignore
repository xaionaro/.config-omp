# Runtime state and generated artifacts (not configuration)
install-id
run/
logs/
cache/
natives/
*.db
*.db-shm
*.db-wal
agent/last-changelog-version
agent/cache/
agent/predict/
agent/sessions/
agent/terminal-sessions/
agent/custom-session-files/
agent/blobs/
agent/optional-hooks/coding-skill-gate
# Built executables and their receipts in agent/eci/bin stay ignored. The negated
# entries are tracked on-demand wrappers or scripts, not prebuilt binaries.
agent/eci/bin/*
!agent/eci/bin/owned-command
!agent/eci/bin/status-report
!agent/eci/bin/eci-runtime-sync
# eci-active is an on-demand wrapper: its built .eci-active.<key> and build lock stay ignored.
!agent/eci/bin/eci-active
# eci-requirement-assignment is an on-demand wrapper: track the script; its built .eci-requirement-assignment.<key> and build lock stay ignored.
!agent/eci/bin/eci-requirement-assignment
# eci-active-dispatch is a tracked provider-routing script; its built siblings stay ignored.
!agent/eci/bin/eci-active-dispatch

# Secrets and credentials
auth*.json
agent/auth*.json
*.env
.env
.env.*
*.key
*.pem
*.token
*.secret
