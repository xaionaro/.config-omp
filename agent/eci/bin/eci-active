#!/usr/bin/env bash
# On-demand launcher for the canonical ECI Go tool agent/eci/tools/eci-active, following the
# owned-command wrapper pattern of pre-migration source 575bb81. The first run of each source and
# toolchain builds bin/.eci-active.<key> beside this wrapper, because eciBaseDir() is the
# executable's grandparent directory and the binary must not move. Source and helper libraries
# come from the canonical $HOME/.omp/agent/eci.
set -euo pipefail
case ${HOME:-} in
  /*) ;;
  *) printf 'eci-active: HOME must be an absolute path\n' >&2; exit 1 ;;
esac
eci_home=$HOME/.omp/agent/eci
if [ ! -f "$eci_home/hooks/lib/eci-file-lock.sh" ] || [ ! -f "$eci_home/hooks/lib/eci-go-tool-build.sh" ] || [ ! -f "$eci_home/hooks/lib/eci-native-provision.sh" ] || [ ! -f "$eci_home/tools/eci-active/go.mod" ]; then
  printf 'eci-active: ECI runtime not found at %s; check out ~/.omp and retry\n' "$eci_home" >&2
  exit 1
fi
wrapper=${BASH_SOURCE[0]}
while [ -L "$wrapper" ]; do
  link=$(readlink -- "$wrapper")
  case $link in
    /*) wrapper=$link ;;
    *) wrapper=${wrapper%/*}/$link ;;
  esac
done
case $wrapper in
  */*) bin_dir=${wrapper%/*} ;;
  *) bin_dir=. ;;
esac
bin_dir=$(cd -P -- "$bin_dir" && pwd -P)
# manifest-write runs the eci-safe-import beside the eci-active binary (manifest.go:39), while the loader verifies
# only the canonical $eci_home/bin copy. A wrapper outside that directory would run an unverified importer.
if [ "${1-}" = manifest-write ] && [ "$bin_dir" != "$(cd -P -- "$eci_home/bin" 2>/dev/null && pwd -P)" ]; then
  printf 'eci-active: manifest-write runs only from %s/bin; this wrapper resolves to %s, whose eci-safe-import is not verified\n' "$eci_home" "$bin_dir" >&2
  exit 1
fi
source "$eci_home/hooks/lib/eci-file-lock.sh"
source "$eci_home/hooks/lib/eci-go-tool-build.sh"
exec 9>"$bin_dir/.eci-active-build.lock"
eci_file_lock_acquire_fd 9 blocking
eci_go_tool_build eci-active "$eci_home/tools/eci-active" "$bin_dir/.eci-active." '' 'about 30 seconds' || exit $?
executable=$eci_go_tool_executable
# Selection refreshes the mtime under the lock. Only keys unselected for 24 hours are pruned, so a
# caller between unlock and exec keeps its file.
touch -c -- "$executable"
find "$bin_dir" -maxdepth 1 -type f -name '.eci-active.*' ! -name "${executable##*/}" -mmin +1440 -exec rm -f -- {} + || true
eci_file_lock_release_fd 9
# First use builds the native tools that the hooks verify (hooks/lib/eci-native-provision.sh). Usage output and
# maintain-planner, which builds the pair itself, skip it. A provisioning failure is an advisory, except that
# manifest-write always verifies, through the loader, the eci-safe-import it is about to run.
case ${1-} in
  ''|--help|-h|maintain-planner) ;;
  *)
    source "$eci_home/hooks/lib/eci-native-provision.sh"
    eci_native_provision || true
    if [ "$1" = manifest-write ]; then
      eci_runtime_verify eci-safe-import || { printf '%s\n' "$ECI_RUNTIME_DENY_REASON" >&2; exit 1; }
    fi
    ;;
esac
exec "$executable" "$@"
