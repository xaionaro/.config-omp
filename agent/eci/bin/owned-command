#!/usr/bin/env bash
# Build the canonical host guard on demand; keep generated executables out of Git.
set -euo pipefail

source_dir=${OWNED_COMMAND_SOURCE:-$HOME/.omp/agent/eci/tools/owned-command}
cache_dir=${OWNED_COMMAND_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/eci/owned-command}
resolve_executable=false
if [[ ${1:-} == --resolve-executable ]]; then
  [[ $# == 1 ]] || {
    printf 'owned-command: --resolve-executable accepts no other arguments\n' >&2
    exit 1
  }
  resolve_executable=true
fi
if [[ ${1:-} == --wrapper-help ]]; then
  cat <<'EOF'
Usage: owned-command [guard flags] -- command args...
       owned-command -help
       owned-command --resolve-executable

Builds ECI tools/owned-command automatically and forwards arguments/status.
OWNED_COMMAND_SOURCE: Go module directory override (default ~/.omp/agent/eci/tools/owned-command).
OWNED_COMMAND_CACHE: generated executable cache (default ${XDG_CACHE_HOME:-$HOME/.cache}/eci/owned-command).
Linux (cgroup v2 custody) and macOS (process-group backend with a narrower guarantee; see the source README.md). Source changes rebuild before the next invocation. Requires Go, the file-lock and
build helpers in ~/.omp/agent/eci/hooks/lib, and sha256sum or shasum.
Cache versions belong to this wrapper; remove old versions only after their callers exit.
--resolve-executable prepares without executing and prints one absolute cache path.
Resolve before timed phases; execute that path directly with caller arguments/environment.
Resolve again to select changed source/toolchain settings. Retain the path while in use.
Guard flags and receipt semantics: owned-command -help and the source README.md.
EOF
  exit 0
fi
kernel=$(uname -s)
case $kernel in
  Linux | Darwin) ;;
  *)
    printf 'owned-command: supported on Linux and macOS only; %s is not supported\n' "$kernel" >&2
    exit 1
    ;;
esac
# The libraries come from the canonical ECI tree only; a caller-relative path is not trusted.
case ${HOME:-} in
  /*) ;;
  *) printf 'owned-command: HOME must be an absolute path\n' >&2; exit 1 ;;
esac
eci_home=$HOME/.omp/agent/eci
if [ ! -f "$eci_home/hooks/lib/eci-file-lock.sh" ] || [ ! -f "$eci_home/hooks/lib/eci-go-tool-build.sh" ]; then
  printf 'owned-command: ECI runtime not found at %s; check out ~/.omp and retry\n' "$eci_home" >&2
  exit 1
fi
source "$eci_home/hooks/lib/eci-file-lock.sh"
source "$eci_home/hooks/lib/eci-go-tool-build.sh"
mkdir -p -- "$cache_dir"
cache_dir=$(cd -P -- "$cache_dir" && pwd -P)
# One builder per cache. Immutable filenames remain safe after unlocking and exec.
exec 9>"$cache_dir/build.lock"
eci_file_lock_acquire_fd 9 blocking
# The shared build step prints the cold-build notice and the rerun line on failure, both on stderr.
eci_go_tool_build owned-command "$source_dir" "$cache_dir/" /owned-command 'about 1-2 minutes' || exit $?
executable=$eci_go_tool_executable
eci_file_lock_release_fd 9
if "$resolve_executable"; then
  case $executable in
    *$'\r'*|*$'\n'*)
      printf 'owned-command: resolved executable path contains CR/LF\n' >&2
      exit 1
      ;;
  esac
  printf '%s\n' "$executable"
  exit 0
fi
exec "$executable" "$@"
